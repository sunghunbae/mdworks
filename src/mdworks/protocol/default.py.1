__all__ = ['UDefault',]


"""Unbiased Classical Molecular Dynamics"""

import logging

from pathlib import Path
from openmm import app, unit

from openmd.unbiased import UnbiasedMD
from openmd.validcomplex import ValidComplex
from openmd.utils import setup_logger


logger = logging.getLogger(__name__)


class UDefault(UnbiasedMD):

    def __init__(self, complex: ValidComplex, quiet: bool = False) -> None:
        # initialize parent class, UnbiasedMD
        # inherit all methods and attributes from UnbiasedMD
        super().__init__(complex, quiet=quiet)
        setup_logger(logger, self.parent, self.prefix, quiet=quiet)

    
    def _add_reporter(self, stage: int, interval: int) -> None:
        # add reporter
        self.simulation.reporters.append(
            app.StateDataReporter(
                (self.workdir / f'{self.prefix}_{self.tags[stage]}.ene').as_posix(), 
                interval,
                step=True,
                potentialEnergy=True,
                temperature=True,
                volume=True,
                density=True))
        

    def _del_reporter(self) -> None:
        self.simulation.reporters.pop()
        

    def _stage_0(self, stage: int = 0) -> None:
        if self.load_checkpoint(stage):
            return
        
        logger.info(f"({stage}) Energy Minimization")
        self._add_reporter(stage, interval=10)
        self.simulation.minimizeEnergy(
                tolerance = 0.1 * unit.kilojoule_per_mole / unit.nanometer,
                maxIterations= 5000)
        # defaults:
        #   tolerance: The default value is 10.0 kJ/mole. 
        #       The minimization stops when the energy change falls below this tolerance.
        #   maxIterations: The default value is 0. When set to 0 (the default), 
        #       minimization continues until convergence is achieved, 
        #       regardless of the number of iterations performed.
        self._del_reporter()
        self.save_checkpoint(stage)


    def _stage_1(self, ps: float = 100, stage: int = 1) -> None:
        if self.load_checkpoint(stage):
            return
        logger.info(f'({stage}) NVT (T= 10 K, posres_k=1000 kJ/mol/nm**2, dt=1 fs, t={ps} ps)')
        # T=10-50K friction=1-5 dt=1 fs t=50-200 ps
        self._change_temperature(temp=10, reset=True)
        self._change_posres(k=1000)
        steps = self._get_steps(ps=ps)
        self._add_reporter(stage, interval=1000)
    
        # run Brownian dynamics
        # self._change_integrator(temp=10, friction=50, timestep=1)
        # self.simulation.step(int(0.5*steps))

        # run simulation
        self._change_integrator(temp=10, friction=5, timestep=1)
        self.simulation.step(steps)

        # remove reporter
        self._del_reporter()
        self.save_checkpoint(stage)


    def _stage_2(self, ps: float = 145, stage: int = 2) -> None:
        if self.load_checkpoint(stage):
            return
        T_prod = (self.temperature / unit.kelvin)
        logger.info(f'({stage}) NVT heating (T= 10-{T_prod} K, posres_k=1000 kJ/mol/nm**2, dt=1 fs, t={ps} ps)')
        # 400-700 ps
        self._change_temperature(temp=10, reset=True)
        self._change_integrator(temp=10, friction=1, timestep=1)
        self._change_posres(k=1000)
        self._add_reporter(stage, interval=1000)

        # gradually heat up the system (it runs simulation.step())
        steps = self._get_steps(ps=ps)
        self._ramp_temperature(steps, start=10, end=T_prod, dT=10.)

        # remove reporter
        self._del_reporter()
        self.save_checkpoint(stage)


    def _stage_3(self, ps: float = 500, stage: int = 3) -> None:
        if self.load_checkpoint(stage):
            return
        T_prod = (self.temperature / unit.kelvin)
        logger.info(f'({stage}) NPT restrained (T={T_prod} K, posres_k=1000-0 kJ/mol/nm**2, dt=1 fs, t={ps} ps)')
        # dt=2 fs t=500-1000 ps
        # add barostat
        self._add_barostat(frequency=50)

        # reinitialize velocities
        self._change_temperature(temp=T_prod, reset=True)
        self._change_integrator(temp=T_prod, friction=1, timestep=1)
        self._change_posres(k=1000)
        self._add_reporter(stage, interval=1000)
    
        # gradually decrease posres (it runs simulation.step())
        steps = self._get_steps(ps=ps)
        self._ramp_posres(steps, start=1000, end=0, dk=-20.0)

        # remove reporter
        self._del_reporter()
        self.save_checkpoint(stage)

    
    def _stage_4(self, ps: float = 1000, stage: int = 4)-> None:
        if self.load_checkpoint(stage):
            return
        T_prod = (self.temperature / unit.kelvin)
        logger.info(f'({stage}) NPT unrestrained (T={T_prod} K, posres_k=0 kJ/mol/nm**2, dt=1 fs, t={ps} ps)')
        # dt=2 fs t=1000-5000 ps
        self._change_temperature(temp=T_prod)
        self._change_integrator(temp=T_prod, friction=1, timestep=1)
        self._change_posres(k=0)
        steps = self._get_steps(ps=ps)
        self._add_reporter(stage, interval=1000)
        
        # run simulation
        self.simulation.step(steps)

        # remove reporter
        self._del_reporter()
        self.save_checkpoint(stage)


    def _stage_5(self, hmr: bool = True, stage: int = 5) -> None:
        logger.info(f"({stage}) NPT production (T= {self.temperature}, dt={self.timestep.in_units_of(unit.femtosecond)}, t={self.time.in_units_of(unit.nanosecond)})")
        logger.info(f"checkpoint interval {str(self.checkpoint_interval.in_units_of(unit.picosecond))}")
        logger.info(f"trajectory interval {str(self.trajectory_interval.in_units_of(unit.picosecond))}")
        logger.info(f"trajectory frames {self.trajectory_frames}")
        T_prod = (self.temperature / unit.kelvin)
        dt_prod = (self.timestep / unit.femtosecond)

        if not self._resume_prod_simulation():

            if hmr:
                self._set_hmr(fs=4.0)
            else:
                self._change_temperature(temp=T_prod)
                self._change_integrator(temp=T_prod, friction=1.0, timestep=dt_prod)
                self._change_posres(k=0)
                while not self._is_prod_stable():
                    self._continue_pre_prod_equilibration()

            # add reporters
            self.simulation.reporters.append(
                app.CheckpointReporter(
                    (self.workdir / f'{self.prefix}_{self.tags[-1]}.cpt').as_posix(),
                    int(self.checkpoint_interval / self.timestep + 0.5),
                    ))
            self.simulation.reporters.append(
                app.DCDReporter(
                    (self.workdir / f'{self.prefix}_{self.tags[-1]}.dcd').as_posix(),
                    int(self.trajectory_interval / self.timestep + 0.5),
                    ))
            self.simulation.reporters.append(
                app.StateDataReporter(
                    (self.workdir / f'{self.prefix}_{self.tags[-1]}.ene').as_posix(),
                    int(self.state_data_interval / self.timestep + 0.5),
                    step=True,
                    potentialEnergy=True,
                    temperature=True,
                    volume=True,
                    density=True,
                    progress=True,
                    remainingTime=True,
                    speed=True,
                    totalSteps=self.steps))

            # run simulation
            self.simulation.step(self.steps)


    def run(self,
            temperature: float = 300.0,
            pressure: float = 1.0, 
            timestep : float = 2.0,
            time : float = 10.0,
            hmr : bool = True,
            state_data_interval : float = 100,
            trajectory_interval : float = 100,
            checkpoint_interval : float = 100,
            workdir : str| Path | None = None):
        """Run multi-stage MD simulation.

        Note:
            All arguments apply to the production stage.

        Args:
            temperature (float, optional): temperature in kelvin. Defaults to 300.0.
            pressure (float, optional): pressure in bar. Defaults to 1.0.
            timestep (float, optional): timestep in femtosecond. Defaults to 2.0.
            time (float, optional): time in nanosecond. Defaults to 10.0.
            state_data_interval (float, optional): state data interval time in ps. Defaults to 100.
            trajectory_interval (float, optional): trajectory interval time in ps. Defaults to 100.
            checkpoint_interval (float, optional): checkpoint interval time in ps. Defaults to 100.
            workdir (str | Path | None, optional): output directory. Defaults to None (same directory as input).
        """
        if workdir is None:
            self.workdir = self.parent
        elif isinstance(workdir, str):
            self.workdir = Path(workdir)

        # production stage settings
        self.temperature = temperature * unit.kelvin
        self.pressure = pressure * unit.bar
        self.timestep = timestep * unit.femtoseconds
        self.time = time * unit.nanoseconds
        self.steps = int(self.time / self.timestep + 0.5)
        self.state_data_interval = state_data_interval * unit.picoseconds
        self.trajectory_interval = trajectory_interval * unit.picoseconds
        self.checkpoint_interval = checkpoint_interval * unit.picoseconds
        self.trajectory_frames = int(self.time / self.trajectory_interval + 0.5)
        self.tags = [
            '0_min', 
            '1_nvt_cold', 
            '2_nvt_warm', 
            '3_npt_posres', 
            '4_npt_free', 
            '5_prod',
            ]
        
        if self.load_checkpoint(stage=4):
            self._stage_5(hmr)

        elif self.load_checkpoint(stage=3):
            self._stage_4()
            self._stage_5(hmr)

        elif self.load_checkpoint(stage=2):
            self._stage_3()
            self._stage_4()
            self._stage_5(hmr)
        
        elif self.load_checkpoint(stage=1):
            self._stage_2()
            self._stage_3()
            self._stage_4()
            self._stage_5(hmr)
        
        elif self.load_checkpoint(stage=0):
            self._stage_1()
            self._stage_2()
            self._stage_3()
            self._stage_4()
            self._stage_5(hmr)
        
        else:
            self._stage_0()
            self._stage_1()
            self._stage_2()
            self._stage_3()
            self._stage_4()
            self._stage_5(hmr)
        
        # final update
        self.positions = self.simulation.context.getState(getPositions=True).getPositions()

        with open(workdir / f"{self.prefix}_final.pdb", "w") as f:
            app.PDBFile.writeFile(self.topology, self.positions, f)

        # Save final state
        logger.info(
            f"\nSimulation complete!"
            f"\nTrajectory saved to {self.prefix}.dcd"
            f"\nThe last structure saved to {self.prefix}_final.pdb"
            )
